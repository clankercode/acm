# Copy to ~/.config/acm/env to override the service's defaults.
# Plain KEY=value lines only -- systemd does not run a shell over this file and
# does not expand $HOME or ~, so every path below has to be written out in full.

# Listen on loopback only instead of every interface.
#ACM_HOST=127.0.0.1

# 8808 by default; 8787 is the older codex-session-monitor.
#ACM_PORT=8808

# Restrict the scan. Known clients: codex, claude, pi, opencode, grok.
#ACM_SOURCES=codex,claude

# Where the corpora are, if they are not in the usual places.
#ACM_SESSIONS_DIR=/home/you/.codex-shared/sessions
#ACM_CLAUDE_DIR=/home/you/.claude/projects
#ACM_PI_DIR=/home/you/.pi/agent/sessions
#ACM_OPENCODE_DB=/home/you/.local/share/opencode/opencode.db
#ACM_GROK_DIR=/home/you/.grok/sessions

# Derived state and the rate table, which default to these. Anything outside
# the directories systemd grants the unit (~/.local/state/acm, ~/.cache/acm,
# ~/.config/acm) also needs a matching ReadWritePaths= in a drop-in.
#ACM_DB=/home/you/.local/state/acm/acm.sqlite
#ACM_PRICING=/home/you/.config/acm/pricing.toml
#ACM_REFERENCE=/home/you/.cache/acm/models-dev.json

# The git checkout the dashboard's Update button builds from. Without it there
# is no button: an installed wheel does not know where it was built.
#ACM_CHECKOUT=/home/you/src/acm

# Allow an update to be requested from another machine. Off by default, and
# worth leaving off: the dashboard has no authentication, so this turns the port
# into "run a shell script on my machine" for anyone who can reach it. It also
# drops the requirement that the update be asked for at localhost, which is what
# stops a DNS-rebinding page from deploying for you.
#ACM_UPDATE_FROM_LAN=1

# Do not put this service behind a reverse proxy on the same host: the update
# endpoint decides who may deploy from the socket's peer address, and a local
# proxy makes every client on the network look local.

# Filesystem watch tuning.
#ACM_DEBOUNCE=0.25
#ACM_POLL=2.0
#ACM_BROADCAST_HZ=4.0
